{
  "name": "speniti/filament-mapbox",
  "description": "A set of tools for integrating Mapbox within the Filament ecosystem.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Peniti\\FilamentMapbox\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Simone Peniti",
      "email": "simone@peniti.it"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4",
    "filament/support": "^5",
    "league/iso3166": "^4"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Peniti\\FilamentMapbox\\FilamentMapboxServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "11",
    "laravel/pint": "^1",
    "larastan/larastan": "^3",
    "filament/filament": "^5",
    "pestphp/pest": "^4",
    "pestphp/pest-plugin-livewire": "^4"
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "@php vendor/bin/pint --verbose --test --ansi",
      "@php vendor/bin/phpstan analyse --verbose --memory-limit 512M --ansi"
    ],
    "test": "@php vendor/bin/pest"
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "workbench/app/",
      "Database\\Factories\\": "workbench/database/factories/",
      "Database\\Seeders\\": "workbench/database/seeders/",
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
