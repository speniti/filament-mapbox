{
  "name": "@peniti/filament-mapbox",
  "description": "Mapbox integration for Filament panels ",
  "type": "module",
  "scripts": {
    "build:scripts": "node esbuild.js",
    "build:styles": "npx @tailwindcss/cli -c tailwind.config.ts -i resources/css/filament-mapbox.css -o dist/filament-mapbox.css",
    "build": "npm-run-all -n -s build:*",
    "lint:styles": "stylelint \"resources/**/*.css\"",
    "lint:scripts": "eslint",
    "lint": "npm-run-all -n -s lint:*",
    "start": "npm-run-all -n -p 'build:* -- --watch'"
  },
  "keywords": [
    "filament",
    "mapbox"
  ],
  "author": {
    "name": "Simone Peniti",
    "email": "simone@peniti.it"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@gitlab-formatters/eslint-formatter-gitlab": "^1.0.1",
    "@gitlab-formatters/stylelint-formatter-gitlab": "^1.0.2",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@shufo/prettier-plugin-blade": "^1.16.1",
    "@types/alpinejs": "^3.13.11",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "@types/mapbox__mapbox-sdk": "^0.16.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "prettier-plugin-css-order": "^2.1.2",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "globals": "^16.3.0"
  }
}
